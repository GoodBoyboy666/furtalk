# Furtalk backend static configuration template.
# Environment names mirror the nested Config sections.
# Priority: non-empty environment variables > configs/config.yaml > defaults.
# Unknown file keys or invalid typed values fail startup. Set FURTALK_CONFIG for an explicit file.
#
# 配置级别（Required / Recommended / Optional）：
# - Required  缺失或为空时启动校验失败，阻止应用启动。
# - Recommended 缺失时使用内置安全默认值，并在启动日志输出一次 warn 告警。
# - Optional  缺失时保持惰性/内存行为，不报错不告警。

# HTTP
# [Recommended] 默认 :8080
FURTALK_HTTP_ADDRESS=:8080
# [Required] 实例公开 Origin；JWT issuer 与 WebAuthn RP 不再从此派生。
FURTALK_HTTP_PUBLIC_BASE_URL=https://furtalk.example.com
# [Recommended] 默认空
# 可信代理 CIDR 列表：仅当直接对端在这些 CIDR 内时解析 X-Forwarded-For 可信
# 代理链（从右向左跳过可信地址，选第一个非可信地址）；未配置时只信任直连地址。
# FURTALK_HTTP_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
# [Recommended] 默认 10s
# FURTALK_HTTP_SHUTDOWN_TIMEOUT=10s
# [Recommended] 默认 5s
# FURTALK_HTTP_READ_HEADER_TIMEOUT=5s
# [Recommended] 默认 15s
# FURTALK_HTTP_READ_TIMEOUT=15s
# [Recommended] 默认 60s
# FURTALK_HTTP_WRITE_TIMEOUT=60s
# [Recommended] 默认 60s
# FURTALK_HTTP_IDLE_TIMEOUT=60s
# [Recommended] 默认 65536
# FURTALK_HTTP_MAX_HEADER_BYTES=65536
# [Recommended] 默认 1048576
# FURTALK_HTTP_BODY_LIMIT=1048576
# [Recommended] 默认 10
# FURTALK_HTTP_RATE_LIMIT_RATE=10
# [Recommended] 默认 100
# FURTALK_HTTP_RATE_LIMIT_BURST=100

# Database
# [Required]
FURTALK_DATABASE_DIALECT=sqlite
# [Required when dialect=sqlite]
FURTALK_DATABASE_PATH=/app/data/furtalk.db
# [Required when dialect=postgres; ignored for sqlite]
# FURTALK_DATABASE_HOST=db.example.com
# FURTALK_DATABASE_PORT=5432
# FURTALK_DATABASE_NAME=furtalk
# FURTALK_DATABASE_USER=furtalk
# FURTALK_DATABASE_PASSWORD=replace-me
# FURTALK_DATABASE_SSL_MODE=require

# Cache
# [Optional]
# FURTALK_CACHE_REDIS_URL=redis://user:pass@redis.example.com:6379/0

# Tokens
# [Required]
FURTALK_TOKENS_JWT_ISSUER=https://furtalk.example.com
# [Recommended] 默认 HS256
# FURTALK_TOKENS_JWT_ALGORITHM=HS256
# [Required] Raw text only, at least 32 bytes; no Base64 decoding is applied.
# 示例占位值短于 32 字节，直接复制会触发启动校验失败；请替换为随机密钥。
FURTALK_TOKENS_JWT_KEY=replace-me
# [Recommended] 默认 168h
# FURTALK_TOKENS_JWT_LIFETIME=168h
# [Recommended] 默认 24h
# FURTALK_TOKENS_WIDGET_JWT_LIFETIME=24h
# [Required] Raw text only, at least 32 bytes; no Base64 decoding is applied.
# 示例占位值短于 32 字节，直接复制会触发启动校验失败；请替换为随机密钥。
FURTALK_TOKENS_SECRET_KEY=replace-me

# WebAuthn
# [Required] RP 边界必须显式提供，不从 public_base_url 推导。
FURTALK_WEBAUTHN_RP_ID=furtalk.example.com
# [Required] 逗号分隔的允许 Origin 列表。
FURTALK_WEBAUTHN_RP_ORIGINS=https://furtalk.example.com
# [Recommended] 默认 Furtalk
# FURTALK_WEBAUTHN_RP_NAME=Furtalk

# OAuth
# [Recommended] 默认 10s
# FURTALK_OAUTH_CLIENT_TIMEOUT=10s

# SMTP
# [Optional] host 为空时通知惰性，port/tls/timeout 不告警。
# FURTALK_SMTP_HOST=smtp.example.com
# [Recommended] 仅启用 SMTP 时生效；默认 587
# FURTALK_SMTP_PORT=587
# [Required，启用 SMTP 时]
# FURTALK_SMTP_FROM=noreply@example.com
# [Recommended] 仅启用 SMTP 时生效；默认 starttls
# FURTALK_SMTP_TLS=starttls
# [Optional] 凭据。
# FURTALK_SMTP_USERNAME=user
# FURTALK_SMTP_PASSWORD=secret
# [Recommended] 仅启用 SMTP 时生效；默认 30s
# FURTALK_SMTP_TIMEOUT=30s
